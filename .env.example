# Code checkout and isolated local runtime identity.
TECHSCOPE_ROOT=
PRITHA_INSTANCE_ID=
PRITHA_INSTANCE_ROLE=developer
PRITHA_STATE_ROOT=
PRITHA_AGENT_PARENT=
PRITHA_CONTROL_CENTER_PORT=3420
PRITHA_SEARXNG_URL=
PRITHA_CONTROL_CENTER_ENV_FILE=<state-root>/config/runtime.env

# Pritha NeuralDeep: the sole non-voice Codex CLI provider. The API key is
# intentionally absent; store it in macOS Keychain under the service below.
PRITHA_NEURALDEEP_ADAPTER_HOST=127.0.0.1
# This fixed port is used only by the manual `serve` command. Normal CLI runs
# allocate an independent loopback port automatically.
PRITHA_NEURALDEEP_ADAPTER_PORT=17861
PRITHA_NEURALDEEP_UPSTREAM_ORIGIN=https://api.neuraldeep.ru
PRITHA_NEURALDEEP_MODEL=qwen3.6-35b-a3b
PRITHA_NEURALDEEP_KEYCHAIN_SERVICE=pritha-neuraldeep
PRITHA_NEURALDEEP_CODEX_HOME=<state-root>/codex-home

# Optional web UI settings.
HOST=127.0.0.1
PORT=3000

# Optional Telegram intake bot.
TECHSCOPE_TELEGRAM_BOT_TOKEN=
TECHSCOPE_TELEGRAM_ALLOWED_USER_IDS=
TECHSCOPE_TELEGRAM_OFFSET=0
TECHSCOPE_TELEGRAM_RETRY_INITIAL_MS=3000
TECHSCOPE_TELEGRAM_RETRY_MAX_MS=60000
TECHSCOPE_TELEGRAM_RETRY_JITTER_RATIO=0.25
TECHSCOPE_TELEGRAM_ERROR_LOG_INTERVAL_MS=60000

# Optional Realtime voice descendants. First-run setup leaves this disabled
# unless the user explicitly opts in and accepts cost/privacy trade-offs.
OPENAI_API_KEY=
TECHSCOPE_REALTIME_MODE=push-to-talk

# Legacy standalone Pritha Voice Control experiment.
# Deprecated: use Pritha Control Center voice runtime on port 3420 instead.
TECHSCOPE_VOICE_HOST=127.0.0.1
TECHSCOPE_VOICE_PORT=3401
TECHSCOPE_VOICE_MODEL=gpt-realtime-2
TECHSCOPE_VOICE_REALTIME_VOICE=marin
TECHSCOPE_VOICE_TRANSCRIPTION_MODEL=gpt-4o-transcribe
TECHSCOPE_VOICE_CODEX_MODE=queue
TECHSCOPE_VOICE_CODEX_WRITE_ENABLED=0
TECHSCOPE_VOICE_PRIVATE_ROOT=

# Optional Pritha Control Center Realtime voice runtime.
# PRITHA_CONTROL_CENTER_ENV_FILE can point to a local ignored env file during experiments.
PRITHA_CONTROL_CENTER_ENV_FILE=
PRITHA_REALTIME_CODEX_MODE=exec
PRITHA_REALTIME_CODEX_MODEL=qwen3.6-35b-a3b
PRITHA_REALTIME_CODEX_WRITE_ENABLED=0
PRITHA_REALTIME_CODEX_TIMEOUT_MS=300000

# Optional Pritha Voice Web Search backend.
# Expected SearXNG endpoint must have JSON enabled in settings.yml:
# search.formats: [html, json]
PRITHA_WEB_SEARCH_BACKEND=searxng
PRITHA_WEB_SEARCH_TIMEOUT_MS=6000
PRITHA_WEB_SEARCH_AUTO_ENSURE=1
PRITHA_WEB_SEARCH_AUTO_ENSURE_TIMEOUT_MS=240000

# Optional generated background music for Pritha Control Center Voice.
# Keep ACE_STEP_API_KEY only in ignored local env files.
MUSIC_DEFAULT_SOURCE=somafm
MUSIC_LIBRARY_ROOT=
SOMAFM_ENABLED=true
SOMAFM_DEFAULT_CHANNEL_ID=groovesalad
SOMAFM_CHANNELS_URL=https://api.somafm.com/channels.json
SOMAFM_FALLBACK_CHANNELS_URL=https://somafm.com/channels.json
SOMAFM_METADATA_TTL_MS=1200000
SOMAFM_TIMEOUT_MS=9000
SOMAFM_USER_AGENT=Pritha/1.0 (+local-control-center)
ACE_STEP_BASE_URL=http://127.0.0.1:8001
ACE_STEP_API_KEY=
ACE_STEP_MODEL=acestep-v15-turbo
ACE_STEP_THINKING=true
ACE_STEP_AUDIO_FORMAT=mp3
ACE_STEP_DEFAULT_DURATION_SEC=60
ACE_STEP_MAX_DURATION_SEC=120
ACE_STEP_POLL_INTERVAL_MS=1000
ACE_STEP_GENERATION_TIMEOUT_MS=120000
MUSIC_DEFAULT_STYLE=calm organ ambient instrumental background music
MUSIC_CACHE_MAX_BYTES=524288000
MUSIC_CACHE_MAX_TRACKS=100

# Optional Control Center local development origins.
# Use comma-separated hostnames only in ignored local env files.
PRITHA_CONTROL_CENTER_ALLOWED_DEV_ORIGINS=

# Optional Control Center private Tailscale access.
# API access through a tailnet host fails closed unless Tailscale identity
# headers are present; restrict accepted logins in ignored local env files.
PRITHA_TAILNET_HOSTNAME=
PRITHA_TAILSCALE_ALLOWED_LOGINS=

# Optional local transcription helpers.
IMAGEIO_FFMPEG_BIN=
MLX_WHISPER_BIN=

# Local setup state is written to .techscope-setup.json. Do not commit it.
TECHSCOPE_SETUP_STATE=

# Optional stricter checks.
TECHSCOPE_ENV_DOCTOR_STRICT=0
TECHSCOPE_GOLDEN_EMBEDDINGS=0
PRITHA_SUPPRESS_DEPRECATION_NOTE=0
